# PostgreSQL connection string (Render / Railway / Neon / Supabase all work)
DATABASE_URL="postgresql://user:password@localhost:5432/energy?schema=public"

# Shared secret the ESP32 firmware sends in the "x-api-key" header when POSTing data.
# Leave blank to disable auth while prototyping.
DEVICE_API_KEY="change-me-to-a-long-random-string"

# Optional admin login for the dashboard (leave blank to disable the login gate)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"
